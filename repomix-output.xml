                      </div>
                    ) : null}

                    {currentStep === 'password' ? (
                      <ValidationChecklist title={t('passwordRules.title')} rules={passwordChecklistRules} />
                    ) : null}
                  </motion.div>
                </AnimatePresence>
              </section>

