# Browser-direct OpenRouter mode is disabled by default.
NEXT_PUBLIC_DEMO_MODE=false

# Optional server-side OpenRouter integration.
# Never expose OPENROUTER_API_KEY through a NEXT_PUBLIC_* variable.
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=
OPENROUTER_BASE_URL=
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=

# Leave empty for same-origin browser requests through Nginx and the BFF.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_WS_BASE_URL=

# Internal Docker URL used only by the Next.js BFF.
BACKEND_ORIGIN=http://web:8000

# HTTP demo only. Set true after enabling HTTPS.
AUTH_COOKIE_SECURE=false

UNIVERSITY_EMAIL_DOMAINS=sbu.ac.ir,student.sbu.ac.ir,mail.sbu.ac.ir
STUDENT_ID_EMAIL_TEMPLATE={id}@student.sbu.ac.ir
NEXT_PUBLIC_STUDENT_EMAIL_DOMAIN=mail.sbu.ac.ir
NEXT_PUBLIC_EMPLOYEE_EMAIL_DOMAIN=sbu.ac.ir
