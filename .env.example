# Optional demo mode (browser-direct OpenRouter). Keep false for secure default behavior.

# Required for server-side BFF proxy to OpenRouter

# Optional OpenRouter settings

# Optional. If omitted, conversation requests use same-origin BFF routes (/api/app/conversations/*)
NEXT_PUBLIC_API_BASE_URL=

# Optional. If omitted, WebSocket uses NEXT_PUBLIC_API_BASE_URL or same origin.
# Use when the backend WebSocket host differs from the HTTP/BFF host.
NEXT_PUBLIC_WS_BASE_URL=

# Authentication cookie transport policy (server-only; never NEXT_PUBLIC_*).
# HTTP demo only. Use true when TLS is enabled.
# Switching between HTTP and HTTPS requires only environment changes:
# - HTTP:  AUTH_COOKIE_SECURE=false and use http:// service origins
# - HTTPS: AUTH_COOKIE_SECURE=true  and use https:// service origins
AUTH_COOKIE_SECURE=false

BACKEND_ORIGIN=http://<domain_or_ip>
UNIVERSITY_EMAIL_DOMAINS=sbu.ac.ir,student.sbu.ac.ir,mail.sbu.ac.ir
STUDENT_ID_EMAIL_TEMPLATE={id}@student.sbu.ac.ir
# University email domains (signup role detection). Defaults match SBU.
NEXT_PUBLIC_STUDENT_EMAIL_DOMAIN=mail.sbu.ac.ir
NEXT_PUBLIC_EMPLOYEE_EMAIL_DOMAIN=sbu.ac.ir
